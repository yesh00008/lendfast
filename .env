# ─── LendFast Environment Variables ──────────────────────────────────────────
POSTGRES_DB=lendfast
POSTGRES_USER=lendfast
POSTGRES_PASSWORD=lendfast_pass

REDIS_PASSWORD=lendfast_redis_pass

RABBITMQ_USER=lendfast
RABBITMQ_PASS=lendfast_pass

DB_URL=postgres://lendfast:lendfast_pass@postgres:5432/lendfast?sslmode=disable
# Used by Python service (SQLAlchemy style)
DATABASE_URL=postgresql://lendfast:lendfast_pass@postgres:5432/lendfast
REDIS_URL=redis://:lendfast_redis_pass@redis:6379
RABBITMQ_URL=amqp://lendfast:lendfast_pass@rabbitmq:5672

JWT_SECRET=lendfast-jwt-secret-key-2024

# Service URLs (Docker Compose internal)
API_GATEWAY_URL=http://api-gateway:8300
BORROWER_SERVICE_URL=http://borrower-service:8301
APPLICATION_SERVICE_URL=http://application-service:8302
UNDERWRITING_SERVICE_URL=http://underwriting-service:8303
LOAN_MANAGEMENT_URL=http://loan-management-service:8304
PAYMENT_SERVICE_URL=http://payment-service:8305
COLLECTIONS_SERVICE_URL=http://collections-service:8306
REPORTING_SERVICE_URL=http://reporting-service:8307

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAMESPACE=lendfast
